# ============================================================================
# Dummy Payment App - local development environment (tested configuration)
#
# Copy this file to .env.local and adjust if your Saleor stack differs:
#
#   cp .env.local.docker.example .env.local
#
# This is the working configuration for the local stack in this project:
# the app runs on the host (Windows) with pnpm dev:local on port 3001,
# while Saleor's API, workers and Dashboard run in Docker behind Traefik.
#
# No secrets are required for this app in local development: authentication
# state (the app token) is received from Saleor at registration time and is
# stored in the gitignored .saleor-app-auth.json file, never in .env.local.
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED (for this Docker setup) - the two base URLs
#
# Both variables are OPTIONAL for the app itself (unset = fall back to the
# request Host header, which is what you want for ngrok/tunnel development
# against Saleor Cloud), but they are REQUIRED to be set correctly when
# Saleor runs in Docker, because the two consumers of the app live on
# different networks:
# ----------------------------------------------------------------------------

# Browser -> app.
# The Saleor Dashboard (loaded in your browser) embeds the app UI as an
# iframe at this URL. It must be reachable from the machine running the
# browser - for a host-side dev server that is plain localhost.
#
# Used as the manifest appUrl. Wrong value -> the Dashboard shows an empty
# or broken iframe and the app UI never loads.
APP_IFRAME_BASE_URL=http://localhost:3001

# Saleor container -> app.
# The Saleor API and worker containers call the app at this URL for:
#   - installation: POST {APP_API_BASE_URL}/api/register
#   - all webhooks:  {APP_API_BASE_URL}/api/webhooks/...
#
# "localhost" inside a Docker container is the container itself, NOT the
# host machine. host.docker.internal is Docker's special hostname that
# points from a container back to the host (Docker Desktop on Windows and
# macOS provide it out of the box; on Linux add extra_hosts:
# ["host.docker.internal:host-gateway"]).
#
# Used as the manifest tokenTargetUrl and as the target URL for every
# webhook declared in the manifest. Wrong value -> installation fails or
# webhooks never arrive and payments silently stop working.
APP_API_BASE_URL=http://host.docker.internal:3001

# ----------------------------------------------------------------------------
# OPTIONAL - installation gate
#
# Regex that the saleor-api-url header must match for /api/register to
# accept the installation. Unset (as in the working local setup) means all
# Saleor instances are allowed. Example for hardening:
#
# ALLOWED_DOMAIN_PATTERN=api\.childnest\.co\.uk:8080/graphql/
# ----------------------------------------------------------------------------
# ALLOWED_DOMAIN_PATTERN=

# ----------------------------------------------------------------------------
# OPTIONAL - auth persistence layer (APL)
#
# The working local setup uses the default "file" APL, so APL does not
# need to be set at all. The auth file lives at
# apps/dummy-payment-app/.saleor-app-auth.json (gitignored) and holds
# { token, saleorApiUrl, appId, jwks } for a single installation.
#
# Behavior notes:
#   - single installation only: the app serves exactly one Saleor instance;
#   - the APL lookup on every tRPC call is an EXACT string match of the
#     saleor-api-url header against the stored saleorApiUrl (trailing
#     slash included) - any mismatch fails with 401 "Missing auth data";
#   - the file is re-read on every request, so re-registration applies
#     without restarting the dev server.
#
# Alternative backends for multi-tenant deployments:
# ----------------------------------------------------------------------------
# APL=file
# APL=upstash          # requires UPSTASH_URL and UPSTASH_TOKEN
# APL=dynamodb         # requires AWS_* and DYNAMODB_MAIN_TABLE_NAME
# FILE_APL_PATH=.saleor-app-auth.json

# ----------------------------------------------------------------------------
# OPTIONAL - DynamoDB (only if APL=dynamodb or for the app's dashboard
# features that persist data). Not needed for the core payment transaction
# flow with the file APL.
# ----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# DYNAMODB_MAIN_TABLE_NAME=
# DYNAMODB_MAIN_TABLE_TIMEOUT_MS=
# DYNAMODB_MAIN_TABLE_CONNECTION_TIMEOUT_MS=

# ----------------------------------------------------------------------------
# OPTIONAL - debugging / housekeeping
# ----------------------------------------------------------------------------

# Log every Saleor GraphQL operation the app performs on the server.
# Enable only when debugging locally; keep off otherwise.
# LOG_SALEOR_OPERATIONS=true

# Secret Vercel Cron sends as a Bearer token to /api/cron/stale-installations.
# Only relevant for the stale-installations cleanup job; leave empty locally.
# CRON_SECRET=
