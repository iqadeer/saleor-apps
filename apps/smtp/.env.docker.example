# ============================================================================
# SMTP App - Docker environment (committed example)
#
# Create the real environment file used by compose.yml from this example:
#
#   Windows (PowerShell):  Copy-Item .env.docker.example .env.docker
#   bash/zsh:              cp .env.docker.example .env.docker
#
# compose.yml references it via `env_file: .env.docker`. The values below
# are the working configuration for the local stack (Saleor + Traefik in
# Docker via the `saleor-platform` repo, app container on `saleor-proxy-net`,
# host ports published for direct localhost access).
#
# SECRET_KEY and CRON_SECRET are real local secrets - keep your .env.docker
# gitignored, and keep the SECRET_KEY identical to the value passed as the
# build arg at image build time (compose.yml interpolates it the same way).
#
# No app authentication lives in this file - the token, saleorApiUrl, appId
# and jwks are stored in the gitignored `.saleor-app-auth.json`, which
# compose.yml bind-mounts into the container.
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED - app secret
#
# Encrypts the SMTP configuration stored in Saleor app privateMetadata.
# - Must be present at BUILD time too (build arg in compose.yml): the env
#   schema parses it at module load during `next build`.
# - The RUNTIME value from this file is the one used to decrypt the
#   configuration at request time - keep both identical.
# - If you rotate it, the stored configuration becomes undecryptable with
#   the old key (see `pnpm rotate-secret-key` on the host for the supported
#   rotation flow).
# ----------------------------------------------------------------------------
SECRET_KEY=

# ----------------------------------------------------------------------------
# REQUIRED - the two base URLs (browser-facing vs container-to-host)
#
# Both must use port 3002 in this deployment: the container listens on
# internal port 3000, and compose.yml maps host port 3002 -> container
# 3000.
# ----------------------------------------------------------------------------

# BROWSER -> APP.
# The Saleor Dashboard (in your browser) embeds the app UI as an iframe at
# this URL, so it must be reachable from the browser: plain localhost.
# Used as the manifest appUrl.
# Change for: a different host port, or Stage 2 (Traefik hostname routing).
APP_IFRAME_BASE_URL=http://localhost:3002

# SALEOR CONTAINER -> APP.
# The Saleor API/worker containers call the app for installation
# (POST {APP_API_BASE_URL}/api/register) and for every webhook
# ({APP_API_BASE_URL}/api/webhooks/...). The value is the URL the Saleor
# containers use to reach this container; the existing installation's
# webhook targets were created with host.docker.internal:3002, so this
# value preserves them (Saleor container -> host port 3002 -> container
# port 3000).
# "localhost" would be WRONG (it is the container itself from inside
# Docker). On Linux add extra_hosts host.docker.internal:host-gateway
# (already in compose.yml).
# Change for: a different host port. For Stage 2 (direct container-to-
# container routing on saleor-proxy-net) use
# http://saleor-app-smtp:3000 and re-register the app (see the README,
# "Running the app as a Docker container").
APP_API_BASE_URL=http://host.docker.internal:3002

# ----------------------------------------------------------------------------
# OPTIONAL - app runtime
# ----------------------------------------------------------------------------

# Shared secret for the cron endpoints (e.g. stale-installations cleanup).
# Empty = endpoints refuse calls.
CRON_SECRET=

# Auth persistence layer. "file" (default) stores auth in
# .saleor-app-auth.json (bind-mounted by compose.yml). DynamoDB is optional
# and NOT needed for the local Docker deployment.
APL=file
FILE_APL_PATH=.saleor-app-auth.json

# Log level for the app.
APP_LOG_LEVEL=info

# Regex the saleor-api-url header must match for /api/register to accept an
# installation. ".*" (with a trailing slash) allows all - the working local
# setup.
ALLOWED_DOMAIN_PATTERN=/*/

# Container internal port (fixed by the Dockerfile/CMD; keep 3000).
PORT=3000

# Always production in the Docker image (the Dockerfile sets this too;
# shown here for clarity - do not set development).
NODE_ENV=production

# OTEL telemetry (Sentry/OTLP) - off in the local deployment.
OTEL_ENABLED=false

# ----------------------------------------------------------------------------
# DO NOT SET: NEW_SECRET_KEY
#
# The env schema declares it as z.string().min(1).optional(): it is either
# absent (key rotation not pending) or a non-empty replacement key. An
# EMPTY value (NEW_SECRET_KEY=) fails validation and crash-loops the
# container at startup. Simply omit the variable.
# ----------------------------------------------------------------------------
