# ============================================================================
# Dummy Payment App - Docker environment (committed example)
#
# Create the real environment file used by compose.yml from this example:
#
#   Windows (PowerShell):  Copy-Item .env.docker.example .env.docker
#   bash/zsh:              cp .env.docker.example .env.docker
#
# compose.yml references it via `env_file: .env.docker`. The values below
# are the working configuration for the local stack (Saleor + Traefik in
# Docker via the `saleor-platform` repo, app container on `saleor-proxy-net`,
# host ports published for direct localhost access).
#
# No secrets live in this file - app authentication (token, saleorApiUrl,
# appId, jwks) is stored in the gitignored `.saleor-app-auth.json`, which
# compose.yml bind-mounts into the container.
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED - the two base URLs (browser-facing vs container-to-host)
#
# Both must use port 3001 in this deployment: the container listens on
# internal port 3000, and compose.yml maps host port 3001 -> container
# 3000.
# ----------------------------------------------------------------------------

# BROWSER -> APP.
# The Saleor Dashboard (in your browser) embeds the app UI as an iframe at
# this URL, so it must be reachable from the browser: plain localhost.
# Used as the manifest appUrl.
# Change for: a different host port, or Stage 2 (Traefik hostname routing,
# e.g. http://dummy.childnest.co.uk:8080).
APP_IFRAME_BASE_URL=http://localhost:3001

# SALEOR CONTAINER -> APP.
# The Saleor API/worker containers call the app for installation
# (POST {APP_API_BASE_URL}/api/register) and for every webhook
# ({APP_API_BASE_URL}/api/webhooks/...). The value is the URL the Saleor
# containers use to reach this container; the existing installation's
# webhook targets were created with host.docker.internal:3001, so this
# value preserves them (Saleor container -> host port 3001 -> container
# port 3000).
# "localhost" would be WRONG (it is the container itself from inside
# Docker). On Linux add extra_hosts host.docker.internal:host-gateway
# (already in compose.yml).
# Change for: a different host port. For Stage 2 (direct container-to-
# container routing on saleor-proxy-net) use
# http://saleor-app-dummy-payment:3000 and re-register the app (see the
# README, "Running the app as a Docker container").
APP_API_BASE_URL=http://host.docker.internal:3001

# ----------------------------------------------------------------------------
# OPTIONAL - app runtime
# ----------------------------------------------------------------------------

# Container internal port (fixed by the Dockerfile/CMD; keep 3000).
PORT=3000

# Always production in the Docker image (the Dockerfile sets this too;
# shown here for clarity - do not set development).
NODE_ENV=production

# ----------------------------------------------------------------------------
# BUILD-TIME ONLY - not a runtime setting
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at `next build`
# time by Next.js - they CANNOT be changed at container run time. The
# Dockerfile declares it as a build ARG and compose.yml passes:
#
#   NEXT_PUBLIC_ALLOW_DUMMY_PAYMENT: ${NEXT_PUBLIC_ALLOW_DUMMY_PAYMENT:-true}
#
# so it is read from the shell, a .env file, or `--env-file .env.docker`.
# Keep it true for this initial deployment (Dummy Payment is the active
# payment method until Stripe replaces it).
#
# Why build time: Next.js statically replaces process.env.NEXT_PUBLIC_* in
# the browser bundle during the build. The storefront's client-side gateway
# filter depends on this - the same rule that broke the Paper storefront
# once (storefront-paper commit d421e605). Changing the value requires a
# rebuild:  docker compose up -d --build app
# ----------------------------------------------------------------------------
NEXT_PUBLIC_ALLOW_DUMMY_PAYMENT=true

# ----------------------------------------------------------------------------
# OPTIONAL - not needed for local Docker deployment (documented for
# completeness; all have working defaults)
# ----------------------------------------------------------------------------

# Auth persistence layer. "file" (default) stores auth in
# .saleor-app-auth.json (bind-mounted by compose.yml).
# APL=file
# FILE_APL_PATH=.saleor-app-auth.json

# Regex the saleor-api-url header must match for /api/register to accept an
# installation. Unset = allow all (the working local setup).
# ALLOWED_DOMAIN_PATTERN=api\.childnest\.co\.uk:8080/graphql/

# Log level for the app.
# APP_LOG_LEVEL=info

# Shared secret for the stale-installations cleanup cron endpoint
# (/api/cron/stale-installations). Empty locally = endpoint refuses calls.
# CRON_SECRET=
